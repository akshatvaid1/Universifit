# ==============================================================================
# Ascend Full-Stack Root Environment Configuration (.env.example)
# Copy this file to .env or backend/.env and supply your local or production credentials
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND (Vite / React) CONFIGURATION
# ------------------------------------------------------------------------------
VITE_API_BASE_URL="http://localhost:5000"
VITE_RAZORPAY_KEY_ID="rzp_test_samplekeyid123"

# ------------------------------------------------------------------------------
# 2. BACKEND SERVER CONFIGURATION
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"

# ------------------------------------------------------------------------------
# 3. DATABASE (PostgreSQL + Prisma ORM)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ascend_db?schema=public"

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & JWT SECURITY
# ------------------------------------------------------------------------------
JWT_SECRET="super-secret-ascend-jwt-key-change-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"

# Google OAuth 2.0 Credentials (Sign In with Google via Passport)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:5000/auth/google/callback"

# ------------------------------------------------------------------------------
# 5. RATE LIMITING (Brute-force & Anti-abuse Protection)
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=15
RATE_LIMIT_CHECKOUT_MAX=20

# ------------------------------------------------------------------------------
# 6. RAZORPAY PAYMENT GATEWAY (Orders, Verification, Webhooks & Subscriptions)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID="rzp_test_samplekeyid123"
RAZORPAY_KEY_SECRET="sample_secret_key_from_env_never_hardcoded"
RAZORPAY_WEBHOOK_SECRET="sample_webhook_secret_from_env"

# ------------------------------------------------------------------------------
# 7. OBJECT STORAGE: AWS S3 OR CLOUDFLARE R2 (Verification Docs, Certificates & Media)
# ------------------------------------------------------------------------------
# Cloudflare R2 / AWS S3 S3-compatible API
S3_REGION="auto"
S3_ENDPOINT="" # Leave empty for AWS S3 default or e.g. https://<account_id>.r2.cloudflarestorage.com
S3_BUCKET_NAME="ascend-verification-docs"
S3_ACCESS_KEY_ID="your_s3_or_r2_access_key_id"
S3_SECRET_ACCESS_KEY="your_s3_or_r2_secret_access_key"
S3_PUBLIC_DOMAIN="https://assets.ascend.io"

# AWS SDK Standard Environment Variables
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your_aws_access_key_id"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key"
AWS_S3_BUCKET="ascend-verification-docs"

# ------------------------------------------------------------------------------
# 8. VIDEO HOSTING: MUX & CLOUDFLARE STREAM (Course Studio & Lessons)
# ------------------------------------------------------------------------------
MUX_TOKEN_ID="your_mux_token_id"
MUX_TOKEN_SECRET="your_mux_token_secret"

CLOUDFLARE_STREAM_ACCOUNT_ID="your_cloudflare_stream_account_id"
CLOUDFLARE_STREAM_API_TOKEN="your_cloudflare_stream_api_token"

# ------------------------------------------------------------------------------
# 9. TRANSACTIONAL EMAILS (Resend / Sendgrid)
# ------------------------------------------------------------------------------
RESEND_API_KEY="re_sample_api_key_123"
# SENDGRID_API_KEY="SG.sample_sendgrid_key"
EMAIL_FROM="notifications@ascend.fit"

# ------------------------------------------------------------------------------
# 10. GOOGLE CALENDAR & MEET INTEGRATION (1-on-1 Sessions)
# ------------------------------------------------------------------------------
GOOGLE_API_KEY="your_google_api_key"
GOOGLE_REFRESH_TOKEN="your_google_refresh_token"
GOOGLE_CALENDAR_ID="primary"

# ------------------------------------------------------------------------------
# 11. OBSERVABILITY & SENTRY REAL-TIME TELEMETRY
# ------------------------------------------------------------------------------
# Frontend Sentry DSN (Vite)
VITE_SENTRY_DSN=""

# Backend Sentry DSN (Node / Express)
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"

# Critical Failure Alert Webhook (Slack, Discord, or PagerDuty incoming webhook URL)
ALERT_WEBHOOK_URL=""

# Winston Logger Level: debug, info, warn, error
LOG_LEVEL="debug"

# ------------------------------------------------------------------------------
# 12. PRIVACY-RESPECTING PRODUCT ANALYTICS (PostHog)
# ------------------------------------------------------------------------------
# PostHog Project API Key (Leave blank for privacy local diagnostic mode)
VITE_POSTHOG_KEY=""
# PostHog API Host (default: https://us.i.posthog.com or https://eu.i.posthog.com)
VITE_POSTHOG_HOST="https://us.i.posthog.com"

